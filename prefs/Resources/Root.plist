<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>SwitzachWidgetProbe</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Widgets</string>
			<key>footerText</key>
			<string>Starts every widget's process again and draws the widgets anew: for a widget that stopped updating or shows an error.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Restart Widgets</string>
			<key>action</key>
			<string>restartWidgets:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Safety</string>
			<key>footerText</key>
			<string>When part of a widget (its data loading, its settings, its rendering) crashes, SwitzachWidgetProbe stops running that part for that app, and stops a widget whose process keeps crashing. Reset to try them again.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Reset Widget Safety Guards</string>
			<key>action</key>
			<string>resetSafetyGuards:</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Diagnostics</string>
			<key>footerText</key>
			<string>Writes a detailed log to Library/Caches/SwitzachWidgetProbe/runtime.txt in the home screen's folder. Crashes are always recorded there. Leave this off for normal use.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Diagnostic Log</string>
			<key>key</key>
			<string>DiagnosticLog</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.rinapple.switzachwidgetprobe</string>
			<key>PostNotification</key>
			<string>com.rinapple.switzachwidgetprobe/settings</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>SwitzachWidgetProbe @VERSION@

Add widgets with the home screen's + button. Touch and hold a widget to change its size, edit it or its stack, or remove it.</string>
		</dict>
	</array>
</dict>
</plist>
